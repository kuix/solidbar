<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Solidbar licenses</title>
<!-- Generated by cargo-about from about.hbs; see about.toml. Don't edit by hand. -->
<style>
  :root {
    --bg: #ffffff;
    --text: #1d1d1f;
    --muted: #57575c;
    --line: #d2d2d7;
    --link: #0a58c2;
    --code-bg: #f5f5f7;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1c1e;
      --text: #f5f5f7;
      --muted: #aeaeb2;
      --line: #3a3a3c;
      --link: #6cb4ff;
      --code-bg: #2c2c2e;
    }
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  }
  main { max-width: 760px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 28px; line-height: 1.2; margin: 0 0 16px; }
  h2 { font-size: 20px; line-height: 1.3; margin: 48px 0 4px; }
  a { color: var(--link); }
  .muted { color: var(--muted); }
  .license { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 16px; }
  .crates { margin: 0 0 8px; }
  pre {
    margin: 0;
    padding: 12px;
    border-radius: 6px;
    background: var(--code-bg);
    font: 12px/1.45 ui-monospace, Menlo, monospace;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
</head>
<body>
<main>
<h1>Solidbar licenses</h1>
<p>
  Solidbar is © 2026 kuix design s.r.o. and the Solidbar contributors. You may use, copy, change
  and share it under the MIT License or the Apache License 2.0, at your option. It is provided
  “as is”, without warranty of any kind; see
  <a href="https://github.com/kuix/solidbar/blob/main/LICENSE-MIT">LICENSE-MIT</a> and
  <a href="https://github.com/kuix/solidbar/blob/main/LICENSE-APACHE">LICENSE-APACHE</a>.
</p>
<p>
  Solidbar is built with the open-source Rust crates below. Each is under its own license, whose
  text follows its name. Solidbar isn’t an official solidtime product.
</p>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> <span class="muted">({{count}} {{#if (eq count 1)}}crate{{else}}crates{{/if}})</span></li>
{{/each}}
</ul>
{{#each overview}}

<section aria-labelledby="{{id}}">
<h2 id="{{id}}">{{name}}</h2>
{{#each indices}}
{{#with (lookup @root.licenses this)}}
<div class="license">
<p class="crates">
{{#each used_by}}
  <a href="https://crates.io/crates/{{crate.name}}/{{crate.version}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}},{{/unless}}
{{/each}}
</p>
<pre>{{text}}</pre>
</div>
{{/with}}
{{/each}}
</section>
{{/each}}
</main>
</body>
</html>
