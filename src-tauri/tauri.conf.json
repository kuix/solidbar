{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solidbar",
  "version": "0.5.2",
  "identifier": "co.kuix.solidbar",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../crates/ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../crates/ui",
      "wait": true
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../crates/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Solidbar",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 10
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A menu bar client for solidtime",
    "copyright": "Copyright © 2026 kuix design s.r.o. and the Solidbar contributors",
    "resources": {
      "../THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "solidtime"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQzY4NjZDMTQzMTMwNzcKUldSM01ERVViSWJHWVk3ODN2YXI0ZEhJNVp2OGgrTjMyMUZpMEVKblVvOWNTTWVRamhoYW1QL1AK",
      "endpoints": [
        "https://github.com/kuix/solidbar/releases/latest/download/latest.json"
      ]
    }
  }
}
